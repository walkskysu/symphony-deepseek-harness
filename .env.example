# Local secrets for Symphony. Copy to `.env` (which is git-ignored) next to
# your WORKFLOW.md, then fill in the values. Launch environment variables still
# win over this file; an exported empty value shadows it.
#
#   Copy-Item .env.example .env

# GitHub token used by the github tracker adapter (and its host-side tools).
# Fine-grained PAT: select only the target repository, Issues: Read (add
# "Read and write" when the agent should comment or change labels).
GITHUB_TOKEN=

# Optional: model key for the coding agent. The DSH headless profile reads the
# launch environment, then <workspace>/.env, then $DSH_HOME/.env — so you can
# either put the key here or let DSH manage it.
# DEEPSEEK_API_KEY=
